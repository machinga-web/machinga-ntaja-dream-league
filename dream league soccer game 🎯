<script>
function goPage(id){
  var all=document.getElementsByClassName('page');
  for(var i=0;i<all.length;i++){all[i].style.display='none'; all[i].classList.remove('active');}
  var t=document.getElementById(id);
  if(t){t.style.display='block'; t.classList.add('active');}
  var tabs=document.querySelectorAll('.tabs button');
  for(var j=0;j<tabs.length;j++){tabs[j].classList.remove('active');}
  var btn=document.getElementById('btn-'+id);
  if(btn){btn.classList.add('active');}
  var bots=document.querySelectorAll('.bottom span');
  for(var k=0;k<bots.length;k++){bots[k].classList.remove('active');}
  var b=document.getElementById('b-'+id);
  if(b){b.classList.add('active');}
  window.scrollTo(0,0);
}
function openTour(name,sub,period,p1,p2,p3){
  document.getElementById('tourName').textContent=name;
  document.getElementById('tourSub').textContent=sub;
  document.getElementById('tourPeriod').textContent=period;
  document.getElementById('p1').textContent=p1;
  document.getElementById('p2').textContent=p2;
  document.getElementById('p3').textContent=p3;
  document.getElementById('tableTitle').textContent=name;
  goPage('home');
}
var teams=[];
function registerTeam(){
  var n=document.getElementById('regTeamName').value;
  var m=document.getElementById('regManager').value;
  if(!n||!m){alert('Lembani Dzina la Team ndi Manager!'); return;}
  teams.push(n+' - Manager: '+m+' - '+document.getElementById('regTour').value);
  document.getElementById('regMsg').innerHTML='✅ Team '+n+' Yalembetsedwa!';
  document.getElementById('teamCount').innerHTML=teams.length;
  document.getElementById('teamsList').innerHTML=teams.join('<br>');
  document.getElementById('regTeamName').value='';
}
</script>
