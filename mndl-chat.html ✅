<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VICTOR EDWARD CHAT</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#111b21;font-family:Arial;height:100vh;display:flex;flex-direction:column}
.top{background:#000;padding:12px;display:flex;align-items:center;gap:12px;color:#fff;border-bottom:3px solid #FFD60A}
.logo{width:45px;height:45px;border-radius:50%;background:#FFD60A;display:flex;align-items:center;justify-content:center;font-size:24px}
.top h2{font-size:17px;color:#FFD60A}
.top p{font-size:11px;color:#8696a0}
.login{flex:1;background:#0a0a0a;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:20px}
.box{background:#000;padding:25px;border-radius:15px;width:90%;max-width:350px;text-align:center;border:2px solid #FFD60A}
.box h1{color:#FFD60A;margin-bottom:8px;font-size:22px}
.box input{width:100%;padding:14px;border:2px solid #333;border-radius:25px;background:#111;color:#fff;margin:10px 0;text-align:center;font-size:15px}
.btn{background:#FFD60A;color:#000;border:none;padding:14px;width:100%;border-radius:25px;font-weight:bold;cursor:pointer;margin-top:10px;font-size:16px}
.chat{display:none;flex:1;flex-direction:column}
.msgs{flex:1;overflow-y:auto;padding:12px;background:#0b141a}
.bubble{max-width:78%;padding:9px 12px;border-radius:12px;margin:7px 0;word-wrap:break-word;font-size:14px}
.other{background:#202c33;color:#fff;align-self:flex-start}
.me{background:#FFD60A;color:#000;align-self:flex-end;margin-left:auto}
.time{font-size:10px;color:#555;float:right;margin-left:8px;margin-top:5px}
.bar{background:#000;padding:10px;display:flex;gap:8px;border-top:2px solid #FFD60A}
.bar input{flex:1;padding:13px;border-radius:25px;border:2px solid #333;background:#111;color:#fff}
.send{background:#FFD60A;width:48px;height:48px;border-radius:50%;border:none;color:#000;font-size:20px;cursor:pointer}
</style>
</head>
<body>
<div class="top"><div class="logo">👑</div><div><h2>VICTOR EDWARD CHAT</h2><p>Machinga Ntaja - Yaulere</p></div></div>
<div id="login" class="login"><div class="box">
<h1>👑 VICTOR EDWARD CHAT</h1>
<input id="userName" placeholder="Dzina Lanu">
<button class="btn" onclick="joinChat()">LOWANI</button>
</div></div>
<div id="chat" class="chat"><div class="msgs" id="msgs"></div>
<div class="bar"><input id="msgIn" placeholder="Lembani..." onkeypress="if(event.key==='Enter')sendMsg()"><button class="send" onclick="sendMsg()">➤</button></div></div>
<script>
let myName="",topic="victor-edward-chat-2026",lastId="";
function joinChat(){let n=document.getElementById('userName').value.trim();if(!n){alert("Lowetsani dzina!");return;}myName=n;document.getElementById('login').style.display='none';document.getElementById('chat').style.display='flex';addMsg("BOT","Takulandirani BOSS "+myName+"! VICTOR EDWARD CHAT yayamba!");listen();setInterval(listen,2500);}
function addMsg(name,text){let box=document.getElementById('msgs');let div=document.createElement('div');let isMe=name===myName;div.className='bubble '+(isMe?'me':'other');let time=new Date().toLocaleTimeString().slice(0,5);div.innerHTML=(isMe?'':'<b style="color:#FFD60A;font-size:11px">'+name+'</b><br>')+text+'<span class="time">'+time+' ✓✓</span>';box.appendChild(div);box.scrollTop=999999;}
async function sendMsg(){let inp=document.getElementById('msgIn');let txt=inp.value.trim();if(!txt)return;try{await fetch('https://ntfy.sh/'+topic,{method:'POST',body:JSON.stringify({name:myName,text:txt})});addMsg(myName,txt);inp.value="";}catch(e){addMsg(myName,txt);inp.value="";}}
async function listen(){try{let r=await fetch('https://ntfy.sh/'+topic+'/json?poll=1');let t=await r.text();let lines=t.split('\n').filter(l=>l.trim());for(let l of lines){try{let j=JSON.parse(l);if(!j.message)continue;if(j.id===lastId)continue;let inner=JSON.parse(j.message);if(inner.name===myName)continue;lastId=j.id;addMsg(inner.name,inner.text);}catch(e){}}}catch(e){}}
</script>
</body>
</html>
